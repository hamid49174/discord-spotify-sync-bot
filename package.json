{
  "name": "discord-spotify-sync-bot",
  "version": "1.0.0",
  "description": "Production-ready Discord bot that mirrors a user's Spotify playback into a Discord voice channel.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lavalink-client": "^2.10.2",
    "pino": "^10.3.1",
    "spotify-web-api-node": "^5.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/spotify-web-api-node": "^5.0.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  }
}
